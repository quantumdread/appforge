# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.npm/
*.tgz

# ── Build output ──────────────────────────────────────────────────────────────
# Regenerated by `npm run build:core` (catalog, content and Power Fx data).
server/src/generated/
server/coverage/
server/.nyc_output/
*.tsbuildinfo
.cache/
.eslintcache
# Two bundles ARE committed on purpose, so they work without `npm install`:
#   cli/dist/analyzer-core.mjs  (the CLI core)
#   server/dist-local/appforge-mcp.mjs                 (the local MCP server)
# Don't add a rule that matches `dist/` or `dist-local/` without re-including them.

# ── Logs and runtime files ────────────────────────────────────────────────────
*.log
logs/
*.pid
report.[0-9]*.json

# ── Secrets and local configuration: never commit ────────────────────────────
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
*.pem
*.key
*.pfx
*.p12
secrets/

# ── Cloudflare / Wrangler local state ─────────────────────────────────────────
.wrangler/

# ── Customer and tenant material: never in this repository ────────────────────
# Real app exports, solution packages and survey output stay outside the repo.
assets/
private/
_private/
*.msapp
appforge-survey/

# ── Local tool state (AI coding assistants, test browsers, scratch) ──────────
**/.claude/settings.local.json
**/.claude/worktrees/
**/.claude/checkpoints/
**/.claude/scheduled_tasks.*
**/.claude/routines/.state/
**/.claude/mailbox/
**/.claude/agent-registry.json
**/.claude/agent-memory-local
**/.claude/first-run
**/.claude/assistant-daemon-state.json
CLAUDE.local.md
.codex/
.playwright-mcp/
.xdg/
# Job logs and scratch reports at the repository root (docs/**/reports/ stays tracked).
/reports/

# ── Editors and operating systems ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Local assistant instruction files stay on your machine ───────────────────
CLAUDE.md
**/CLAUDE.md
AGENTS.md
**/AGENTS.md
**/.claude/
**/.codex/
