{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__.*__compile_canvas$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/cli/precompile-hook.mjs"],
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__.*__compile_canvas$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/cli/postcompile-hook.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
